# ─────────────────────────────────────────────────────────────────────────────
#  Realm of Ages — Environment Variables
#  Copy this file to .env and fill in your values.
#  NEVER commit .env to git. It is already in .gitignore.
# ─────────────────────────────────────────────────────────────────────────────

# ── Server ───────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000

# ── Session Secret ────────────────────────────────────────────────────────────
# REQUIRED in production. Use a long random string (64+ chars).
# Generate one: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
SESSION_SECRET=change-this-to-a-long-random-secret-string

# ── Database ──────────────────────────────────────────────────────────────────
# LOCAL DEV: Leave empty — SQLite is used automatically (no setup needed).
# PRODUCTION: Set this to your Neon/Supabase/Railway PostgreSQL connection string.
# Format: postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require
DATABASE_URL=

# ── Game Tuning (optional) ────────────────────────────────────────────────────
# How many minutes between each +1 turn (default: 2)
TURN_REGEN_MINUTES=2
# Maximum turn cap per player (default: 200)
TURN_MAX=200

# ── Dev Tools (optional) ────────────────────────────────────────────────────
# Adds a "Dev: wipe this test account" button (server/routes/dev.js) so the
# creator can re-test registration/login/faction-select without a new email.
# It is hardcoded to only ever affect DEV_RESET_EMAIL, no matter who calls it.
# Set to false to disable the button/route entirely without a code change.
DEV_TOOLS_ENABLED=true
DEV_RESET_EMAIL=chanthasena.peter@gmail.com
